rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
//  Contabilidad ME — Reglas de seguridad de Firestore (versión endurecida)
// ════════════════════════════════════════════════════════════════════════════
//
//  VERSIÓN FINAL — aislamiento estricto, lista para pegar en
//  Firebase → Firestore Database → Reglas → Publicar (reemplaza TODO).
//
//  ⚠️  Requisito previo: la base tiene que estar migrada.
//      Configuración → Sistema → 🔒 Aislamiento por empresa → "Preparar",
//      hasta que el panel quede en verde. La migración hace dos cosas:
//        1. crea un documento en `empresas_acl` por cada empresa del catálogo
//        2. estampa el campo `empresa` en todos los documentos existentes
//      Si se publican estas reglas antes, la app deja de leer sus propios datos.
//
//  Si algo sale mal, la consola de Firebase guarda el historial de reglas
//  publicadas y permite volver a la versión anterior en un clic.
//
//  Modelo de datos
//  ───────────────
//  usuarios/<email>              { email, nombre, rol, activo, pendiente, ... }
//      rol ∈ { 'admin', 'contador', 'consulta' }
//
//  empresas_acl/<empresaId>      { nombre, creadoPor, miembros:[emails], ts }
//      Espejo legible por las reglas del catálogo de empresas. Existe porque
//      el catálogo real (`contabilidad_data/_empresas`) es un JSON dentro de un
//      string y las reglas no saben parsear JSON.
//
//  contabilidad_data/<id>        { value:<string JSON>, empresa:<id|'_global'>, ts }
//      id = "<empresaId>:<clave>"   → datos de una empresa   (ej "emp1:ventas-2026")
//      id = "_<algo>"              → catálogo y configuración global
//
//  audit_log/<auto>              { accion, detalle, usuario, ts }
//  _meta/ping                    documento vacío para probar conectividad
//
//  Qué garantiza
//  ─────────────
//  · Un usuario sólo lee y escribe los datos de las empresas de las que es
//    miembro. Ya no basta con estar autenticado.
//  · El rol 'consulta' no puede escribir en ninguna parte.
//  · Un usuario no puede editar su propio rol ni activarse solo.
//  · Nadie puede reasignar un documento a otra empresa (el campo `empresa`
//    debe coincidir con el prefijo del id).
//  · El registro de auditoría es de sólo agregar: nadie borra su rastro.
// ════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identidad ──────────────────────────────────────────────────────────
    // Los documentos de usuario usan el email en minúsculas como id.
    function correo() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }
    function rutaUsuario() {
      return /databases/$(database)/documents/usuarios/$(correo());
    }
    function registrado() {
      return correo() != '' && exists(rutaUsuario());
    }
    function datosUsuario() {
      return get(rutaUsuario()).data;
    }
    function activo() {
      return registrado() && datosUsuario().activo == true;
    }
    function rol() {
      return registrado() ? datosUsuario().rol : '';
    }
    function esAdmin() {
      return activo() && rol() == 'admin';
    }
    // Escribir exige estar activo y NO ser de sólo consulta
    function escribe() {
      return activo() && rol() != 'consulta';
    }

    // ── Pertenencia a una empresa ──────────────────────────────────────────
    function rutaAcl(emp) {
      return /databases/$(database)/documents/empresas_acl/$(emp);
    }
    function hayAcl(emp) {
      return emp != '' && exists(rutaAcl(emp));
    }
    function miembro(emp) {
      return emp == '_global'
        || esAdmin()
        || (hayAcl(emp) && correo() in get(rutaAcl(emp)).data.miembros);
      // Nota: una empresa sin documento en `empresas_acl` queda fuera del
      // alcance de todos menos los administradores. Si alguna vez hay que
      // migrar otra base desde cero, agrega temporalmente `|| !hayAcl(emp)`
      // como tercera condición para que nada se rompa mientras se crean las
      // fichas, y bórralo apenas el panel de Configuración → Sistema quede
      // en verde.
    }

    // ── Empresa a la que pertenece un documento, según su id ───────────────
    // "emp1:ventas-2026" → "emp1"   ·   "_empresas" → "_global"
    function esGlobal(id) {
      return id.matches('^_.*');
    }
    function empresaDeId(id) {
      return (esGlobal(id) || !id.matches('.*:.*')) ? '_global' : id.split(':')[0];
    }

    // ── Documentos globales: catálogo y preferencias ───────────────────────
    // `_empresaActiva:<email>` guarda qué empresa dejó abierta cada usuario:
    // sólo su dueño puede tocarlo.
    function globalPropio(id) {
      return !id.matches('^_empresaActiva:.*')
        || id == '_empresaActiva:' + correo();
    }

    // ═══ usuarios ═══════════════════════════════════════════════════════════
    match /usuarios/{email} {
      // Cada quien lee su propia ficha; los admin leen todas.
      allow get: if request.auth != null && (email == correo() || esAdmin());

      // El arranque del sistema (auth.js) consulta `limit(2)` para saber si es
      // el primer usuario. Se permite esa consulta acotada a cualquier
      // autenticado; el listado completo queda sólo para administradores.
      allow list: if esAdmin()
        || (request.auth != null && request.query.limit <= 2);

      // Alta, por dos caminos:
      //
      //  a) Un ADMINISTRADOR invita a alguien (Configuración → Usuarios →
      //     "Invitar nuevo usuario"): pre-autoriza el email con su rol, para
      //     que entre directo sin quedar pendiente.
      //  b) Alguien se REGISTRA solo: crea su propia ficha y SIEMPRE inactiva
      //     y de sólo consulta. Nadie se auto-promueve; el admin aprueba.
      //
      // En ambos casos el id del documento debe ser el email que lleva dentro.
      //
      // ⚠️ Proyecto nuevo: el atajo de "primer usuario = admin" que trae la app
      // no puede comprobarse desde las reglas, así que aquí queda prohibido.
      // Para arrancar de cero, crea a mano el primer documento en la consola:
      //   usuarios/<tu-email>  { email, nombre, rol:'admin', activo:true, pendiente:false }
      allow create: if request.auth != null
        && request.resource.data.email == email
        && (
             esAdmin()
             || (
                  email == correo()
                  && request.resource.data.rol == 'consulta'
                  && request.resource.data.activo == false
                )
           );

      // Modificación: un admin cambia lo que quiera; un usuario común sólo
      // puede refrescar sus datos de sesión. `hasOnly` es lo que impide que
      // alguien se cambie el rol o se active a sí mismo.
      allow update: if esAdmin()
        || (
             activo() && email == correo()
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['nombre','foto','ultimoLogin'])
           );

      allow delete: if esAdmin() && email != correo();
    }

    // ═══ empresas_acl — quién puede ver cada empresa ════════════════════════
    match /empresas_acl/{empresaId} {
      allow read: if activo();

      // Crear el ACL de una empresa: debes quedar tú como dueño.
      // (La migración de empresas heredadas la hace un administrador.)
      allow create: if escribe()
        && request.resource.data.miembros is list
        && (esAdmin() || request.resource.data.creadoPor == correo());

      // Modificar miembros: sólo el dueño o un admin. Una empresa heredada
      // (sin dueño) la puede reclamar cualquier usuario que pueda escribir.
      // El dueño debe seguir dentro de `miembros`: nadie se deja fuera solo.
      allow update: if escribe()
        && request.resource.data.miembros is list
        && (
             request.resource.data.creadoPor == ''
             || request.resource.data.creadoPor in request.resource.data.miembros
           )
        && (
             esAdmin()
             || !('creadoPor' in resource.data)      // ACL a medio escribir
             || resource.data.creadoPor == ''        // empresa heredada: reclamable
             || resource.data.creadoPor == correo()  // eres el dueño
           );

      allow delete: if esAdmin();
    }

    // ═══ contabilidad_data — todos los datos contables ══════════════════════
    match /contabilidad_data/{docId} {

      // Lectura de un documento suelto: la empresa se deduce del id, así que
      // funciona incluso si el documento todavía no tiene el campo `empresa`.
      allow get: if activo()
        && (esGlobal(docId) ? true : miembro(empresaDeId(docId)));

      // Consultas: aquí las reglas no pueden mirar el id, así que se apoyan en
      // el campo `empresa`. Por eso la app consulta con
      // `.where('empresa','==',<id>)` y por eso la migración estampa el campo
      // en los documentos antiguos. Un documento sin `empresa` no se lista.
      allow list: if activo()
        && resource.data.empresa is string
        && miembro(resource.data.empresa);

      // Escritura: además de pertenecer a la empresa, el campo `empresa` debe
      // coincidir con el prefijo del id. Esto impide que alguien "mueva" un
      // documento a otra empresa o cree basura fuera de su ámbito.
      allow create, update: if escribe()
        && request.resource.data.empresa == empresaDeId(docId)
        && (esGlobal(docId) ? globalPropio(docId) : miembro(empresaDeId(docId)));

      allow delete: if escribe()
        && (esGlobal(docId) ? globalPropio(docId) : miembro(empresaDeId(docId)));
    }

    // ═══ audit_log — sólo agregar, nadie borra su rastro ════════════════════
    match /audit_log/{id} {
      allow read: if esAdmin();
      allow create: if activo();
      allow update, delete: if false;
    }

    // ═══ _meta — ping de conectividad (se consulta antes de autenticarse) ═══
    match /_meta/{doc} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ═══ Todo lo demás queda cerrado ════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
